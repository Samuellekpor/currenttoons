      "parameters": {
        "command": "=cd \"$PIPELINE_ROOT\" && .venv/bin/python scripts/generate_images.py --channel {{ $json.channel }} --row-id {{ $json.rowId }}"
      },
      "id": "c3d4e5f6-0001-4000-8000-000000000005",
      "name": "Generate images",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [760, 340]
    }
