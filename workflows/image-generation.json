      "position": [200, 480],
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "REPLACE_GOOGLE_SHEETS_CREDENTIAL_ID",
          "name": "Google Sheets"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const row = $input.first().json;\nconst status = String(row['Statut (À Revoir/Accepté/Rejeté)'] || '').trim();\nconst images = String(row['Images Générées'] || '').trim().toLowerCase();\nconst checked = ['true','1','yes','oui','x','checked'].includes(images);\nconst rowId = row.row_number || row.rowNumber || row.row || row.id;\nif (status !== 'Script Généré' || checked) { return []; }\nreturn [{ json: { rowId, channel: 'currenttoons' } }];"
      },
      "id": "c3d4e5f6-0001-4000-8000-000000000003",
      "name": "If Script Généré currenttoons",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [480, 200]
    },
    {
      "parameters": {
        "jsCode": "const row = $input.first().json;\nconst status = String(row['Statut (À Revoir/Accepté/Rejeté)'] || '').trim();\nconst images = String(row['Images Générées'] || '').trim().toLowerCase();\nconst checked = ['true','1','yes','oui','x','checked'].includes(images);\nconst rowId = row.row_number || row.rowNumber || row.row || row.id;\nif (status !== 'Script Généré' || checked) { return []; }\nreturn [{ json: { rowId, channel: 'habitlens' } }];"
      },
      "id": "c3d4e5f6-0001-4000-8000-000000000004",
      "name": "If Script Généré habitlens",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [480, 480]
    },
