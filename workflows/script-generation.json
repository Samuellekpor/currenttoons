      "position": [200, 200],
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "REPLACE_GOOGLE_SHEETS_CREDENTIAL_ID",
          "name": "Google Sheets"
        }
      }
    },
    {
      "parameters": {
        "pollTimes": {
          "item": [
            {
              "mode": "everyMinute"
            }
          ]
        },
        "event": "rowUpdate",
        "documentId": {
          "__rl": true,
          "mode": "id",
          "value": "={{ $env.HABITLENS_SHEET_ID }}"
        },
        "sheetName": {
          "__rl": true,
          "mode": "name",
          "value": "Sujets"
        },
        "options": {}
      },
      "id": "b2c3d4e5-0001-4000-8000-000000000002",
      "name": "Sheet habitlens updated",
      "type": "n8n-nodes-base.googleSheetsTrigger",
      "typeVersion": 1,
      "position": [200, 480],
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "REPLACE_GOOGLE_SHEETS_CREDENTIAL_ID",
          "name": "Google Sheets"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const row = $input.first().json;\nconst status = String(row['Statut (À Revoir/Accepté/Rejeté)'] || '').trim();\nconst format = String(row['Format Vidéo (Court/Long)'] || '').trim();\nconst language = String(row['Langue (FR/EN)'] || '').trim();\nconst already = String(row['Script Vidéo Généré'] || '').trim();\nconst rowId = row.row_number || row.rowNumber || row.row || row.id;\nif (status !== 'Accepté' || !format || !language || already) {\n  return [];\n}\nreturn [{ json: { rowId, channel: 'currenttoons' } }];"
      },
      "id": "b2c3d4e5-0001-4000-8000-000000000003",
      "name": "If Accepté currenttoons",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [480, 200]
    },
    {
      "parameters": {
        "jsCode": "const row = $input.first().json;\nconst status = String(row['Statut (À Revoir/Accepté/Rejeté)'] || '').trim();\nconst format = String(row['Format Vidéo (Court/Long)'] || '').trim();\nconst language = String(row['Langue (FR/EN)'] || '').trim();\nconst already = String(row['Script Vidéo Généré'] || '').trim();\nconst rowId = row.row_number || row.rowNumber || row.row || row.id;\nif (status !== 'Accepté' || !format || !language || already) {\n  return [];\n}\nreturn [{ json: { rowId, channel: 'habitlens' } }];"
      },
      "id": "b2c3d4e5-0001-4000-8000-000000000004",
      "name": "If Accepté habitlens",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [480, 480]
    },
    {
      "parameters": {
        "command": "=cd \"$PIPELINE_ROOT\" && .venv/bin/python scripts/generate_script.py --channel {{ $json.channel }} --row-id {{ $json.rowId }}"
      },
      "id": "b2c3d4e5-0001-4000-8000-000000000005",
      "name": "Generate script",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [760, 340]
    }
  ],
