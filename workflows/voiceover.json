        "options": {}
      },
      "id": "d4e5f6a7-0001-4000-8000-000000000001",
      "name": "Sheet currenttoons updated",
      "type": "n8n-nodes-base.googleSheetsTrigger",
      "typeVersion": 1,
      "position": [200, 200],
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "REPLACE_GOOGLE_SHEETS_CREDENTIAL_ID",
          "name": "Google Sheets"
        }
      }
    },
    {
      "parameters": {
        "pollTimes": { "item": [{ "mode": "everyMinute" }] },
        "event": "rowUpdate",
        "documentId": { "__rl": true, "mode": "id", "value": "={{ $env.SECOND_CHANNEL_SHEET_ID }}" },
        "sheetName": { "__rl": true, "mode": "name", "value": "Sujets" },
        "options": {}
      },
      "id": "d4e5f6a7-0001-4000-8000-000000000002",
