      "position": [200, 480],
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "REPLACE_GOOGLE_SHEETS_CREDENTIAL_ID",
          "name": "Google Sheets"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const row = $input.first().json;\nconst status = String(row['Statut (À Revoir/Accepté/Rejeté)'] || '').trim();\nconst checked = (v) => ['true','1','yes','oui','x','checked'].includes(String(v || '').trim().toLowerCase());\nconst rowId = row.row_number || row.rowNumber || row.row || row.id;\nif (status !== 'Script Généré' || !checked(row['Images Générées']) || checked(row['Voix-off Générée'])) { return []; }\nreturn [{ json: { rowId, channel: 'currenttoons' } }];"
      },
      "id": "d4e5f6a7-0001-4000-8000-000000000003",
      "name": "If ready currenttoons",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [480, 200]
    },
    {
      "parameters": {
        "jsCode": "const row = $input.first().json;\nconst status = String(row['Statut (À Revoir/Accepté/Rejeté)'] || '').trim();\nconst checked = (v) => ['true','1','yes','oui','x','checked'].includes(String(v || '').trim().toLowerCase());\nconst rowId = row.row_number || row.rowNumber || row.row || row.id;\nif (status !== 'Script Généré' || !checked(row['Images Générées']) || checked(row['Voix-off Générée'])) { return []; }\nreturn [{ json: { rowId, channel: 'second_channel' } }];"
      },
      "id": "d4e5f6a7-0001-4000-8000-000000000004",
      "name": "If ready second_channel",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [480, 480]
    },
    {
      "parameters": {
        "command": "=cd \"$PIPELINE_ROOT\" && .venv/bin/python scripts/generate_voiceover.py --channel {{ $json.channel }} --row-id {{ $json.rowId }}"
      },
      "id": "d4e5f6a7-0001-4000-8000-000000000005",
      "name": "Generate voiceover",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [760, 340]
    }
  ],
